*.pem
*.key
*.p12
*.pfx
credentials.tfrc.json

# Terraform runtime artifacts that a workflow fixture may produce locally
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan

# Bun artifacts; bun.lock must stay tracked
**/node_modules/
/.bun/
*.tsbuildinfo

# Downloaded CLI used by local integration checks; never committed
/.rootform-cli/

