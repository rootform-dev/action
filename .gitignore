# Operating systems and editors
.DS_Store
Thumbs.db
*.swp
*.swo
*~
/.idea/
/.vscode/*
!/.vscode/extensions.json
!/.vscode/settings.json

# Secrets and local environment
**/.env
**/.env.*
!**/.env.example
!**/.env.sample
!**/.env.template
**/.dev.vars
**/.dev.vars.*
